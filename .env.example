# Database

POSTGRES_DB=fake_news_db

POSTGRES_USER=postgres

POSTGRES_PASSWORD=postgres

POSTGRES_PORT=4588



# Backend

BACKEND_PORT=8888



# Frontend

FRONTEND_PORT=5173



# Nginx

NGINX_PORT=4788



# PgAdmin

PGADMIN_EMAIL=admin@fakenews.com

PGADMIN_PASSWORD=admin


# MLOps: define valores secretos reales antes de levantar los servicios.

MLFLOW_TRACKING_URI=http://mlflow:5000
TRAINING_DATASET_PATH=
ALLOW_MODEL_TRAINING=false
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
SCRAPER_INTERVAL_SECONDS=3600


# Airflow — genera una nueva clave con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# URL de base de datos que usarán los DAGs de Airflow para conectarse al backend
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/fake_news_db
